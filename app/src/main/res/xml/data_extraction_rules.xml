<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Zero-knowledge: Dilarang backup database chat ke cloud backup bawaan OS -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Boleh transfer lokal kabel saat ganti HP jika disetujui -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
